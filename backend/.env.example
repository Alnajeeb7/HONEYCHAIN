# --- HoneyChain backend environment --------------------------------------
# Copy to .env. NEVER commit .env. NEVER expose any of these in the frontend.

PORT=4000

# --- Blockchain (EVM integrity layer) ------------------------------------
# Set to 1 to submit real transactions. Left unset/0 => safe DEMO mode
# (app works fully; on-chain calls are simulated, no secrets required).
BLOCKCHAIN_ENABLED=0

# "sepolia" (Ethereum Sepolia, chainId 11155111) or "amoy" (Polygon Amoy, 80002).
BLOCKCHAIN_NETWORK=sepolia

# RPC endpoint (Alchemy/Infura/public). Testnet only.
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Service wallet private key — TESTNET wallet only, funded from a faucet.
# NEVER a personal mainnet wallet. NEVER commit or share this value. Fill locally.
BLOCKCHAIN_PRIVATE_KEY=

# Deployed HoneyChainTraceability address (from blockchain/deployments/<net>.json).
CONTRACT_ADDRESS=

# Optional override for the block explorer base URL.
# BLOCK_EXPLORER_URL=https://sepolia.etherscan.io

# --- IPFS evidence storage -----------------------------------------------
# "pinata" | "local" | "demo" (default). demo = offline deterministic CIDs.
IPFS_PROVIDER=demo

# Pinata JWT (single key) OR key + secret pair.
IPFS_API_KEY=
IPFS_API_SECRET=

# Public gateway used to build "View Evidence" links.
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
