{
  "name": "honeychain-blockchain",
  "version": "1.0.0",
  "private": true,
  "description": "Solidity + Hardhat integrity anchor layer for HoneyChain (additive; does not replace the app).",
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:amoy": "hardhat verify --network amoy",
    "verify:sepolia": "hardhat verify --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.10",
    "dotenv": "^16.4.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  }
}
