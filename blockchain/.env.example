# --- HoneyChain blockchain (Hardhat) environment -------------------------
# Copy to .env and fill in. NEVER commit .env. NEVER share the private key.

# Service wallet private key (testnet only — never a personal mainnet wallet).
# Get testnet funds from a faucet (Amoy / Sepolia). Do NOT send this key to anyone.
BLOCKCHAIN_PRIVATE_KEY=

# Generic RPC (used if a network-specific URL below is not set).
BLOCKCHAIN_RPC_URL=

# Network-specific RPC endpoints (Alchemy / Infura recommended).
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Block explorer API keys for `hardhat verify`.
POLYGONSCAN_API_KEY=
ETHERSCAN_API_KEY=
